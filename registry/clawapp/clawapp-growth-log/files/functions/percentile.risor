# percentile.risor — 按 WHO 生长标准算百分位。**完全离线，一个 token 不花。**
#
# 为什么这件事不能交给模型：百分位是 WHO 公布的 LMS 参数算出来的确定数值，家长
# 会拿这个数字去判断孩子发育是否正常。让模型「估计」它，等于给一个每次都不一样
# 的、无从追溯的数字，还要为此付费和等待。这一半必须是算术。
#
# LMS 方法（WHO Child Growth Standards）：
#   L≠0:  Z = ((X/M)^L − 1) / (L·S)
#   L=0:  Z = ln(X/M) / S
# 再由标准正态分布把 Z 换成百分位。
#
# 参数表在 reference/who_lms.json，随包发布（不是用户数据，升级时整块替换）。
# 表不在就明确说"还没有参数表"，绝不猜——一个编出来的百分位比没有百分位有害。

kid_id := string(ctx.params.get("kid", ""))
metric := string(ctx.params.get("metric", "weight"))   # weight | height
if metric != "weight" && metric != "height" { metric = "weight" }

kid := nil
if kid_id != "" { kid = ctx.entity.find("kid", kid_id) }
if kid == nil {
  ctx.fail("先在「记一笔」里填上孩子的生日和性别")
} else {
  birthday := string(kid.get("birthday", ""))
  sex := string(kid.get("sex", "girl"))
  if sex != "boy" { sex = "girl" }

  if !regexp.match("^[0-9]{4}-[0-9]{2}-[0-9]{2}$", birthday) {
    ctx.fail("孩子的生日填得不对，应该是 2024-03-15 这样")
  } else {
    table := ctx.space.read_json("reference/who_lms.json")
    key := metric + "_" + sex
    rows := nil
    if table != nil { rows = table.get(key, nil) }

    if rows == nil || len(rows) == 0 {
      # 没有参数表时**不给数字**，只把测量值原样列出来。
      ctx.fail("还没有导入 WHO 生长参数表，暂时只能记录数值。参见应用说明里的导入步骤。")
    } else {
      born := time.parse("2006-01-02", birthday).unix()

      # 标准正态分布 CDF（Abramowitz & Stegun 26.2.17，误差 < 7.5e-8）。
      # math 模块没有 exp，用 pow(e, x) 代。
      E := 2.718281828459045
      norm_cdf := func(z) {
        neg := z < 0.0
        x := neg ? 0.0 - z : z
        t := 1.0 / (1.0 + 0.2316419 * x)
        poly := t * (0.319381530 + t * (0.0 - 0.356563782 + t * (1.781477937 +
                t * (0.0 - 1.821255978 + t * 1.330274429))))
        pdf := math.pow(E, 0.0 - x * x / 2.0) / math.sqrt(2.0 * 3.141592653589793)
        upper := pdf * poly
        return neg ? upper : 1.0 - upper
      }

      # 参数表按整月给点，取最接近的月龄行。线性插值会更平滑，但相邻两个月的
      # L/M/S 差别很小，而"取最近"讲得清楚、也不会在月初月末给出跳变的解释。
      lookup := func(months) {
        best := nil
        best_gap := 100000.0
        for _, row := range rows {
          age := float(row.get("month", 0))
          gap := math.abs(age - months)
          if gap < best_gap { best_gap = gap; best = row }
        }
        return best
      }

      all := ctx.entity.query("measure", {"kid": kid_id})
      points := []
      for _, r := range all {
        if string(r.get("metric", "")) != metric { continue }
        date := string(r.get("date", ""))
        if !regexp.match("^[0-9]{4}-[0-9]{2}-[0-9]{2}$", date) { continue }
        value := float(r.get("value", 0))
        if value <= 0.0 { continue }

        days := (time.parse("2006-01-02", date).unix() - born) / 86400
        months := float(days) / 30.4375
        if months < 0.0 { continue }

        lms := lookup(months)
        if lms == nil { continue }
        L := float(lms.get("l", 0))
        M := float(lms.get("m", 0))
        S := float(lms.get("s", 0))
        if M <= 0.0 || S <= 0.0 { continue }

        z := 0.0
        if L == 0.0 {
          z = math.log(value / M) / S
        } else {
          z = (math.pow(value / M, L) - 1.0) / (L * S)
        }
        # 极端值截断：WHO 自己在 ±3 之外就不再报百分位，那个区间的数字没有
        # 临床意义，只会吓到家长。
        shown := z
        if shown > 4.0 { shown = 4.0 }
        if shown < 0.0 - 4.0 { shown = 0.0 - 4.0 }

        points.append({
          "date": date,
          "value": value,
          "months": math.floor(months * 10.0) / 10.0,
          "z": math.floor(z * 100.0) / 100.0,
          "percentile": math.floor(norm_cdf(shown) * 1000.0) / 10.0,
          "median": M,
        })
      }

      if len(points) == 0 {
        ctx.ok("还没有" + (metric == "weight" ? "体重" : "身高") + "记录", {"points": [], "metric": metric})
      } else {
        points = sorted(points, func(a, b) { return string(a.get("date", "")) < string(b.get("date", "")) })
        last := points[len(points) - 1]
        label := metric == "weight" ? "体重" : "身高"
        ctx.ok(sprintf("最近一次%s在第 %.1f 百分位", label, float(last.get("percentile", 0))), {
          "points": points,
          "metric": metric,
          "latest": last,
        })
      }
    }
  }
}
